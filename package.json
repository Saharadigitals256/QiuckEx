{
  "name": "quickex",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:mutation": "pnpm --filter @quickex/backend run test:mutation",
    "db:verify-migrations": "pnpm --filter @quickex/backend run db:verify-migrations",
    "test:perf:horizon": "pnpm --filter @quickex/backend run test:perf:horizon",
    "check:generated-types": "node scripts/check-generated-types.js",
    "check:governance": "node scripts/governance/check.mjs",
    "check:deps": "node scripts/deps/check.mjs",
    "check:deps:licenses": "node scripts/deps/check.mjs --only license --installed",
    "test:governance": "node --test scripts/governance/__tests__/governance.test.mjs",
    "test:deps": "node --test scripts/deps/__tests__/deps.test.mjs",
    "secret-scan": "bash scripts/secret-scan.sh",
    "secret-scan:verify": "bash scripts/secret-scan.sh --verify",
    "secret-scan:full": "bash scripts/secret-scan.sh --full"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "node-fetch": "3",
    "stellar-sdk": "^13.3.0",
    "toml": "^5.0.0"
  }
}
