{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build && node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "echo 'Skipping frontend checks in backend release pipeline' || exit 0",
    "test:telemetry": "vitest run __tests__/errorReporter.smoke.test.ts",
    "test:visual": "playwright test --config=playwright.config.ts",
    "check:bundle": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^17.0.14",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11"
  }
